node_modules/
assets/icon.png
*.backup
.anotifier-backup

# Local secrets — never commit
.env
.env.*
!.env.example

# Graphify knowledge-graph output — generated artifacts, never committed
# (note: .graphifyignore is intentional config and stays tracked)
graphify-out/
.graphify_*

# Python bytecode (scripts/lib/wpn-readback.py and friends)
__pycache__/
*.pyc

# donetoast runtime artifacts, written next to the vendored scripts by its
# live-progress and -Command modes (anotifier uses neither). toast.log is no
# longer written at all; the rule stays for a copy left by an older checkout.
assets/windows/donetoast/toast.log
assets/windows/donetoast/jobs/
assets/windows/donetoast/progress/

# OS-generated cruft
Thumbs.db
.DS_Store
Desktop.ini
