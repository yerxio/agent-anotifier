{
  "name": "anotifier",
  "version": "1.7.1",
  "private": true,
  "description": "Desktop & phone notifications for AI coding agents. Internal fork of DevinoSolutions/anotifier-for-claude-codex-cursor: Windows notifications are Donetoast cards, and setup makes no network request.",
  "type": "module",
  "bin": {
    "anotifier": "cli/index.mjs"
  },
  "main": "./src/notify.mjs",
  "scripts": {
    "test": "node scripts/run-tests.mjs tests",
    "test:e2e": "node scripts/run-tests.mjs tests/e2e",
    "toast:demo": "node scripts/toast-demo.mjs",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin"
  },
  "keywords": [
    "notifications",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "cursor",
    "vscode",
    "ai-agent",
    "ai-coding",
    "coding-agent",
    "toast",
    "ntfy",
    "push-notifications",
    "desktop-notifications",
    "hooks",
    "developer-tools",
    "cross-platform",
    "cli",
    "productivity"
  ],
  "author": {
    "name": "DevinoSolutions",
    "url": "https://github.com/DevinoSolutions"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerxio/agent-anotifier.git"
  },
  "homepage": "https://github.com/yerxio/agent-anotifier#readme",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "cli/",
    "setup/",
    "assets/icons/",
    "assets/windows/",
    "config/",
    "hooks/",
    "commands/",
    ".claude-plugin/"
  ]
}
